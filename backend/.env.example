# Reference only; set in your process environment before startup.
UPSHIFT_FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=C:/path/outside-repository/service-account.json
# Explicit public source hosts for the selected-source worker:
UPSHIFT_SOURCE_HOSTS=careers.selected-company.com
# Optional trusted Member 2 schema-2 model (see backend/README.md):
# UPSHIFT_MODEL_PATH=C:/path/to/handoff/artifacts/upshift_bundle.joblib
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
# Local demo emulators only (never combine with a live project):
# UPSHIFT_FIREBASE_PROJECT_ID=demo-upshift
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
